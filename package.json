{
    "name": "fabric-photo",
    "version": "0.2.0",
    "description": "web 图片编辑器",
    "repository": "",
    "author": "ximing",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "i": "pnpm install",
        "dev": "pnpm --filter fabric-photo-demo dev",
        "build": "pnpm -r build",
        "build:demo": "pnpm --filter fabric-photo-demo build",
        "preview:demo": "pnpm --filter fabric-photo-demo preview",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test"
    },
    "devDependencies": {
        "prettier": "^3.8.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    },
    "onlyBuiltDependencies": [
        "canvas"
    ],
    "pnpm": {
        "overrides": {
            "tar": ">=7.5.21",
            "esbuild": ">=0.28.1",
            "nanoid": "^3.3.18"
        }
    }
}
